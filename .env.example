# Copy this file to `.env` and fill in your real values.
# `.env` is already in .gitignore — never commit real credentials.

# --- MongoDB ---------------------------------------------------------------
# Local MongoDB (e.g. installed via Docker or brew):
# MONGODB_URI=mongodb://localhost:27017
#
# MongoDB Atlas (free cloud cluster) — get this from Atlas > Connect > Drivers:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Name of the database this backend will use (created automatically on first write)
MONGODB_DB_NAME=smart_dermatology

# --- Existing app settings (unchanged) --------------------------------------
# ARTIFACTS_DIR=./artifacts
# MAX_UPLOAD_MB=8
# ALLOWED_ORIGINS=*

# --- Auth --------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=43200
